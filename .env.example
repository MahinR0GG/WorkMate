# Copy this file to .env and fill in your actual values

# ============================================
# LLM Provider: "litellm" (default) | "ollama"
# ============================================
LLM_PROVIDER=litellm

# LiteLLM Proxy (primary)
LLM_BASE_URL=https://<your-litellm-proxy-url>/
LLM_MODEL_NAME=azure/gpt-4o
LLM_API_KEY=<your-litellm-api-key>

# Ollama (fallback — used automatically if LiteLLM proxy is unreachable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
FAISS_INDEX_PATH=embeddings/faiss_index.bin
ID_TO_CHUNK_PATH=embeddings/id_to_chunk.json

# ============================================
# Embedding Model
# ============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# Search Parameters
# ============================================
TOP_K=4
SIMILARITY_THRESHOLD=0.7

# ============================================
# API Settings
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
